<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_dark_brown"
    tools:context=".VerifikasiActivity">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_deep_brown"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/brand_cream"
        app:title="Halaman Verifikasi"
        app:titleTextColor="@color/brand_cream"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:background="@drawable/bg_card_translucent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvTitleVerifikasi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppinsregular"
                android:text="Verifikasi Data Registrasi"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppinsregular"
                android:text="Periksa kembali seluruh isian SharedPreferences di bawah ini:"
                android:textColor="@color/brand_cream"
                android:textSize="12sp" />

            <!-- Display Field: Nama -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/poppinsregular"
                android:text="Nama:"
                android:textColor="@color/brand_cream"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvValNama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/poppinsregular"
                android:padding="10dp"
                android:textColor="@color/brand_dark_navy"
                android:textSize="14sp"
                tools:text="Syauqi" />

            <!-- Display Field: Email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/poppinsregular"
                android:text="Email:"
                android:textColor="@color/brand_cream"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvValEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/poppinsregular"
                android:padding="10dp"
                android:textColor="@color/brand_dark_navy"
                android:textSize="14sp"
                tools:text="syauqi@gmail.com" />

            <!-- Display Field: Tanggal Lahir -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/poppinsregular"
                android:text="Tanggal Lahir:"
                android:textColor="@color/brand_cream"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvValDob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/poppinsregular"
                android:padding="10dp"
                android:textColor="@color/brand_dark_navy"
                android:textSize="14sp"
                tools:text="01/01/2000" />

            <!-- Display Field: Jenis Kelamin -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/poppinsregular"
                android:text="Jenis Kelamin:"
                android:textColor="@color/brand_cream"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvValGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/poppinsregular"
                android:padding="10dp"
                android:textColor="@color/brand_dark_navy"
                android:textSize="14sp"
                tools:text="Laki-laki" />

            <!-- Display Field: Username -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/poppinsregular"
                android:text="Username:"
                android:textColor="@color/brand_cream"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvValUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/poppinsregular"
                android:padding="10dp"
                android:textColor="@color/brand_dark_navy"
                android:textSize="14sp"
                tools:text="syauqi" />

            <!-- Display Field: Password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/poppinsregular"
                android:text="Password:"
                android:textColor="@color/brand_cream"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvValPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/poppinsregular"
                android:padding="10dp"
                android:textColor="@color/brand_dark_navy"
                android:textSize="14sp"
                tools:text="123456" />

            <!-- Display Field: Confirm Password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/poppinsregular"
                android:text="Confirm Password:"
                android:textColor="@color/brand_cream"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvValConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/poppinsregular"
                android:padding="10dp"
                android:textColor="@color/brand_dark_navy"
                android:textSize="14sp"
                tools:text="123456" />

            <!-- Action Buttons Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <!-- Tombol Kembali -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnKembali"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:fontFamily="@font/poppinsregular"
                    android:text="Kembali"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_dark_brown"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Tombol Submit -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSubmit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:fontFamily="@font/poppinsregular"
                    android:text="Submit"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

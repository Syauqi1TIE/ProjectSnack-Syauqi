<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/brand_dark_brown"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_translucent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Edit Icon"
                android:src="@drawable/sobremessa" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppinsregular"
                    android:text="Edit Profil Member"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppinsregular"
                    android:text="Perbarui data diri Anda"
                    android:textColor="@color/brand_cream"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nama Lengkap -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Lengkap"
            android:textColor="@color/brand_cream"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etEditFullName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/poppinsregular"
            android:hint="Nama Lengkap"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/brand_dark_navy"
            android:textSize="14sp"
            android:autofillHints="name"
            android:layout_marginBottom="12dp" />

        <!-- Email (Read-Only / Disabled) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email / Gmail (Terkunci)"
            android:textColor="@color/brand_cream"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etEditEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/poppinsregular"
            android:enabled="false"
            android:inputType="textEmailAddress"
            android:textColor="#777777"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:autofillHints="emailAddress"
            android:layout_marginBottom="12dp" />

        <!-- Tanggal Lahir -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tanggal Lahir"
            android:textColor="@color/brand_cream"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etEditDob"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/poppinsregular"
            android:hint="DD/MM/YYYY"
            android:focusable="false"
            android:clickable="true"
            android:focusableInTouchMode="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/brand_dark_navy"
            android:textSize="14sp"
            android:autofillHints="birthDate"
            android:layout_marginBottom="12dp" />

        <!-- Jenis Kelamin -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jenis Kelamin"
            android:textColor="@color/brand_cream"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <RadioGroup
            android:id="@+id/rgEditGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <RadioButton
                android:id="@+id/rbEditMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Laki-laki"
                android:textColor="@color/brand_dark_navy"
                android:layout_marginEnd="20dp" />
            <RadioButton
                android:id="@+id/rbEditFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perempuan"
                android:textColor="@color/brand_dark_navy" />
        </RadioGroup>

        <!-- Username -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textColor="@color/brand_cream"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etEditUsername"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/poppinsregular"
            android:hint="Username"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/brand_dark_navy"
            android:textSize="14sp"
            android:autofillHints="username"
            android:layout_marginBottom="12dp" />

        <!-- Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password Baru"
            android:textColor="@color/brand_cream"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etEditPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/poppinsregular"
            android:hint="Password"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/brand_dark_navy"
            android:textSize="14sp"
            android:autofillHints="password"
            android:layout_marginBottom="12dp" />

        <!-- Confirm Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konfirmasi Password"
            android:textColor="@color/brand_cream"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etEditConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/poppinsregular"
            android:hint="Konfirmasi Password"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/brand_dark_navy"
            android:textSize="14sp"
            android:autofillHints="password"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
